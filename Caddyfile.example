# myprojects.cc — the whole site is now static, served from one folder, with
# no password. GitHub Pages is the default host (see .github/workflows/deploy.yml);
# this file is only for self-hosting the same static output behind Caddy.
#
# There is no backend and no basic_auth anymore. The War Room, League Vault and
# the bot publish JSON into site/data/ out of band; Caddy just serves files.

{
	email you@example.com
}

(hardened) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	encode gzip
}

myprojects.cc, www.myprojects.cc {
	import hardened
	root * site
	file_server {
		index index.html
	}
	# never cache the data files, so a fresh publish shows immediately
	@data path /data/*
	header @data Cache-Control "no-store"
}
